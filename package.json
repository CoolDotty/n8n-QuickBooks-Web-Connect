{
    "name": "n8n-nodes-quickbooks-web-connector",
    "version": "0.1.0",
    "description": "n8n community node bridge for QuickBooks Desktop Web Connector (QBWC). Exposes a SOAP endpoint as a trigger and provides an action node for enqueueing QBXML jobs and generating .qwc config files.",
    "license": "MIT",
    "homepage": "",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "dot",
        "email": "dot@x3c.ca"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/dot/n8n-nodes-quickbooks-web-connector.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/QuickBooksDesktopApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/QuickBooksDesktop/QuickBooksDesktopTrigger.node.js",
            "dist/nodes/QuickBooksDesktop/QuickBooksDesktop.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.29.0",
        "n8n-workflow": "^2.16.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
